---
layout: base.njk
title: Home
description: Welcome to our 11ty site with Tailwind CSS, TypeScript, and SCSS
---

{% from "components/hero.njk" import hero %}
{% from "components/card.njk" import card %}
{% from "components/button.njk" import button %}
{# Hero, from the Figma redesign (file "Ze UX/UI Portfolio", node 100:6542). #}
<section class="hero" id="about">
    <div class="hero-grid">
        <div class="hero-copy">
            <p class="hero-hello">
                <span>Hello, I’m</span>
                <span class="hero-name">José Ferreira
                    <img src="/assets/images/hero/name-circle.svg" width="275.306" height="85.6615" alt="" class="hero-name-circle" aria-hidden="true">
                </span>
                <span class="hero-arrow" aria-hidden="true">
                    <img src="/assets/images/hero/arrow.svg" width="436.51" height="44.4912" alt="">
                </span>
            </p>
            <h1 class="hero-title">
                <span class="hero-title-text">UX/UI &amp; Product Designer<img src="/assets/images/hero/smiley.svg" width="26.4512" height="37.0056" alt="" class="hero-smiley" aria-hidden="true"></span>
            </h1>
            <p class="hero-subtitle">Focused on clear, trustworthy and impactful digital products</p>
        </div>

        {# Polaroid (component 103:6699, hover variant 103:6698): straightens and drops
           a hard shadow on hover while three strikes pop out from behind its top-right corner. #}
        <figure class="hero-polaroid">
            <img src="/assets/images/hero/polaroid-strike-1.svg" width="34.643" height="34.2561" alt="" class="hero-polaroid-strike hero-polaroid-strike--1" aria-hidden="true">
            <img src="/assets/images/hero/polaroid-strike-2.svg" width="41.456" height="26.2631" alt="" class="hero-polaroid-strike hero-polaroid-strike--2" aria-hidden="true">
            <img src="/assets/images/hero/polaroid-strike-3.svg" width="34.643" height="34.2561" alt="" class="hero-polaroid-strike hero-polaroid-strike--3" aria-hidden="true">
            <div class="hero-polaroid-card">
                <img src="/assets/images/hero/jose.webp" width="820" height="778" alt="José Ferreira smiling, outdoors among plants" class="hero-polaroid-photo">
                <figcaption class="hero-polaroid-caption">That’s me!!</figcaption>
            </div>
        </figure>
    </div>
    <div class="hero-cta">
        {% include "components/open.njk" %}
    </div>
</section>
