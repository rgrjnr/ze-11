{% from "components/page-layer.njk" import pageLayer %}
<section class="container mx-auto relative md:mt-24" id="my-work">
    <h2 class="text-3xl font-bold text-center md:mt-16">My work</h2>
    <p class="text-center mt-3">Real projects for real clients.</p>
</section>
<section class="mt-8">
    {% if collections.work and collections.work.length %}
        {% for project in collections.work %}
            {{ pageLayer(project.data.title, project.data.excerpt, project.url, project.data.image) }}
        {% endfor %}
    {% else %}
        {{ pageLayer("Under construction at the moment", "A real client project is being written up right now. Check back soon!") }}
        {{ pageLayer("Something new is on the way", "Another freelance project is getting its case study ready. Stay tuned!") }}
    {% endif %}
</section>
<section class="container mx-auto relative mt-24 md:mt-32" id="conceptual-projects">
    <h2 class="text-3xl font-bold text-center">Conceptual Projects</h2>
    <p class="text-center mt-3">Projects from my UX/UI studies, where I explored research, strategy and interface design.</p>
    {% include "components/studies.njk" %}
</section>
