{# Conceptual Studies: university case studies shown as pinned post-its.
   Each card has a natural tilt and straightens on hover (see .study-card in input.scss). #}
<ol class="studies-grid">
    {% for study in collections.cases %}
        <li class="study-card-wrapper">
            <a href="{{ study.url }}" class="study-card">
                <svg
                    width="34"
                    height="44"
                    viewBox="0 0 34 44"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    class="study-pin">
                    <path d="M17 26C16.6 31 17.3 36 16.8 41.5" class="stroke"/>
                    <path
                        d="M9.5 10.5C8.8 5.2 13.3 2.2 17.6 2.4C22.4 2.6 25.8 6.2 24.6 11C24.2 12.7 25.9 14.6 28.6 16.2C31.4 17.9 29.8 22.6 26.4 23.4C20.6 24.8 12.6 25.1 7.2 23.6C3.6 22.6 3.1 18.4 6.1 16.7C8.4 15.4 9.8 13 9.5 10.5Z"
                        class="stroke study-pin-head"/>
                </svg>
                <div class="study-card-header">
                    <span class="study-number">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
                    <img src="{{ study.data.image }}" alt="" class="study-thumb" loading="lazy"/>
                </div>
                <h3 class="study-title">{{ study.data.title }}</h3>
                <p class="study-excerpt">{{ study.data.excerpt }}</p>
                <span class="study-more">Read case study
                    <svg width="28" height="15" viewBox="0 0 47 25" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2 12.8509C2.16807 12.9632 5.86826 13.0211 11.5955 12.993C15.1594 12.9755 17.5189 12.7386 22.458 12.5122C25.8806 12.3554 31.1788 12.2859 34.1583 12.2C37.1378 12.114 37.642 12.0579 38.7001 12.0289C39.7582 12 41.3549 12 43 12" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                        <path d="M30.5515 2.29688C31.4304 2.46396 34.4282 4.13991 37.3994 6.08675C40.8088 8.32069 42.0487 9.7146 43.6007 10.7741C44.0116 11.0546 44.4384 11.4867 44.5327 11.7437C44.8242 12.5383 41.7195 13.5931 36.1036 18.5235C34.63 19.7602 33.7431 20.5197 32.8151 21.3627C32.4128 21.7045 32.15 21.8716 31.8791 22.2969" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    </svg>
                </span>
            </a>
        </li>
    {% endfor %}
</ol>
