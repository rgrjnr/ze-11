{# "Open to work" button from the Figma hero (component 76:6277 / hover 76:6276).
   On hover the button lifts up-right and tilts 2deg, revealing a hatched shadow
   and strikes that were hidden behind it. "Don't be shy!!" (Gochi Hand) and a
   hand-drawn arrow sit on its left from 1024px up. #}
<a href="mailto:hi@joseferreira.io" class="hero-button">
    <img src="/assets/images/hero/button-shadow.svg" width="319" height="113.044" alt="" class="hero-button-shadow" aria-hidden="true">
    <img src="/assets/images/hero/button-strikes.svg" width="36.3572" height="33.923" alt="" class="hero-button-strikes" aria-hidden="true">
    <span class="hero-button-face">Open to work</span>
    <span class="hero-shy hidden xl:block">
        <span class="hero-shy-text"><span>Don’t</span><span>be shy!!</span></span>
        {# Arrow from the button's left edge, dipping down and curving up to the text #}
        <svg
            width="200"
            height="70"
            viewBox="0 0 200 70"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            data-draw="true"
            data-stagger="0.15"
            data-delay="1.5"
            class="hero-shy-arrow"
            aria-hidden="true">
            <path d="M168 28C150 47 116 58 85 54C60 50.5 41 36 29.5 17.5" class="stroke"/>
            <path d="M29 17C35.5 17.5 42 18.4 48.5 19.6M29 17C30.2 23.5 31.2 29.5 32.4 36" class="stroke"/>
        </svg>
    </span>
</a>
